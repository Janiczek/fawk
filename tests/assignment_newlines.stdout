Test: Assignment operators with newlines
----------------------------------------
x = [1,2] |> map((a) => {a+1}) = [2, 3]

y = [10, 20, 30] = [10, 20, 30]

z = 42 = 42

a = 5, a += 10 = 15

b = 20, b -= 5 = 15

c = 3, c *= 4 = 12

d = 20, d /= 4 = 5

result = (10 + 5) * 2 = 30

arr = [1, 2, 3] |> map((x) => {x * 2}) = [2, 4, 6]

value = 100 (with multiple newlines) = 100

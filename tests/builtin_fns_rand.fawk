# Test: rand() function

BEGIN {
    print "Test: rand() function"
    print "--------------------------------------"
    
    # Seed for reproducibility
    srand(42)
    
    # Generate some random numbers
    print "  Generating 5 random numbers (seeded with 42):"
    for (i = 1; i <= 5; i = i + 1) {
        r = rand()
        printf("  rand() #%d: %.6f\n", i, r)
    }
    
    print ""
    
    # Verify range (should be 0.0 to 1.0)
    print "  Verifying range:"
    min = 1.0
    max = 0.0
    for (i = 1; i <= 100; i = i + 1) {
        r = rand()
        if (r < min) min = r  # Optional braces test
        if (r > max) max = r  # Optional braces test
    }
    printf("  After 100 calls: min=%.6f, max=%.6f\n", min, max)
}


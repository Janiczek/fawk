# Test: Complete CSV Processing Example

function avg(arr) {
    return sum(arr) / length(arr)
}

BEGIN {
    global sales
    FS = ","  # Set field separator to comma for CSV
    sales = ["electronics" => [], "books" => [], "clothing" => []]
}

# Parse CSV: category,product,price
{
    if (NR > 1) {
        category = $1
        price = int($3)
        sales[category][length(sales[category])] = price
    }
}

END {
    for (cat in sales) {
        average = avg(sales[cat])
        print cat, "average:", average
    }
}

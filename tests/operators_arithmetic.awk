# Test: Arithmetic Operators

BEGIN {
    print "Test: Arithmetic Operators"
    print "--------------------------------------"
    print "  10 + 5 =", 10 + 5
    print "  10 - 5 =", 10 - 5
    print "  10 * 5 =", 10 * 5
    print "  10 / 5 =", 10 / 5
    print "  10 % 3 =", 10 % 3
    print "  -10 =", -10
    print ""
    
    print "Operator Precedence:"
    print "--------------------------------------"
    print "  2 + 3 * 4 =", 2 + 3 * 4
    print "  (2 + 3) * 4 =", (2 + 3) * 4
    print "  10 - 4 / 2 =", 10 - 4 / 2
    print "  (10 - 4) / 2 =", (10 - 4) / 2
}


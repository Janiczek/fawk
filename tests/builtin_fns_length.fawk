# Test: length() function

BEGIN {
    print "Test: length() function"
    print "--------------------------------------"
    
    str = "Hello World"
    arr = [1, 2, 3, 4, 5]
    
    print "  length(\"Hello World\"):", length(str)
    print "  length([1,2,3,4,5]):", length(arr)
    
    # Test empty string and array
    empty_str = ""
    empty_arr = []
    print "  length(\"\"):", length(empty_str)
    print "  length([]):", length(empty_arr)
    
    # Test length() on integers (base 10)
    print ""
    print "  length(0):", length(0)
    print "  length(42):", length(42)
    print "  length(123):", length(123)
    print "  length(-42):", length(-42)
    print "  length(999999):", length(999999)
}


BEGIN {
    # Test membership check with multi-dimensional arrays
    
    arr[1,2] = "value"
    arr[3,4] = "another"
    arr["x","y"] = "string indices"
    
    # Single index in operator (checks the concatenated key)
    # In AWK, (1,2) in arr becomes checking if "1\0342" is a key
    
    # Test with concatenated key
    key = 1 SUBSEP 2
    if (key in arr) {
        print "Found arr[1,2] using concatenated key"
    }
    
    # Test with tuple syntax (i,j) in arr
    # Note: This is checking if the concatenated string is in the array
    if ((1,2) in arr) {
        print "Found arr[1,2] using (1,2) in arr syntax"
    }
    
    if ((1,3) in arr) {
        print "Found arr[1,3]"
    } else {
        print "arr[1,3] not found (expected)"
    }
    
    # Test with 3 indices
    arr2[1,2,3] = "three-d"
    if ((1,2,3) in arr2) {
        print "Found arr2[1,2,3] using (1,2,3) in arr2 syntax"
    }
    
    # Iterate and check keys
    print "All keys in arr:"
    for (k in arr) {
        print "  key:", k, "value:", arr[k]
    }
}


# Test: Assignment operators with newlines after =, +=, -=, *=, /=

BEGIN {
    print "Test: Assignment operators with newlines"
    print "----------------------------------------"
    
    # Basic assignment with newline after =
    x =
      [1,2]
        |> map((a) => {a+1})
    print "x = [1,2] |> map((a) => {a+1}) =", x
    print ""
    
    # Assignment with multiple newlines
    y =
    
        [10, 20, 30]
    print "y = [10, 20, 30] =", y
    print ""
    
    # Assignment with expression on new line
    z =
        42
    print "z = 42 =", z
    print ""
    
    # += with newline
    a = 5
    a +=
        10
    print "a = 5, a += 10 =", a
    print ""
    
    # -= with newline
    b = 20
    b -=
        5
    print "b = 20, b -= 5 =", b
    print ""
    
    # *= with newline
    c = 3
    c *=
        4
    print "c = 3, c *= 4 =", c
    print ""
    
    # /= with newline
    d = 20
    d /=
        4
    print "d = 20, d /= 4 =", d
    print ""
    
    # Assignment with complex expression on new line
    result =
        (10 + 5) * 2
    print "result = (10 + 5) * 2 =", result
    print ""
    
    # Assignment with pipeline on new line
    arr =
        [1, 2, 3]
          |> map((x) => {x * 2})
    print "arr = [1, 2, 3] |> map((x) => {x * 2}) =", arr
    print ""
    
    # Multiple newlines after =
    value =
    
    
        100
    print "value = 100 (with multiple newlines) =", value
}


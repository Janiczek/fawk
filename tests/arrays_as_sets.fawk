BEGIN {
    # Demonstrate using AWK associative arrays as sets
    # Sets store unique keys; the values don't matter
    
    print "=== Using Arrays as Sets ==="
    print ""
    
    set = ["apple" => 1, "banana" => 1, "cherry" => 1]
    
    print "Initial set:"
    for (item in set) {
        print "  " item
    }
    print ""
    
    # Test for membership
    print "Membership tests:"
    if ("apple" in set) {
        print "  apple is in the set"
    }
    
    if ("grape" in set) {
        print "  grape is in the set"
    } else {
        print "  grape is NOT in the set"
    }
    print ""
    
    # Add a new element
    print "Adding 'grape' to set"
    set["grape"] = 1
    if ("grape" in set) {
        print "  grape is now in the set"
    }
    print ""
    
    # Remove an element (use delete in real AWK)
    # For demonstration, we'll show the pattern
    print "Removing 'banana' from set"
    delete set["banana"]
    if ("banana" in set) {
        print "  banana is still in the set"
    } else {
        print "  banana is NOT in the set (removed)"
    }
    print ""
    
    # Toggle an element (add if not present, remove if present)
    print "Toggle operations:"
    item = "cherry"
    if (item in set) {
        print "  Removing " item
        delete set[item]
    } else {
        print "  Adding " item
        set[item] = 1
    }
    
    item = "orange"
    if (item in set) {
        print "  Removing " item
        delete set[item]
    } else {
        print "  Adding " item
        set[item] = 1
    }
    print ""
    
    # Final set
    print "Final set:"
    for (item in set) {
        print "  " item
    }
    print ""
    
    print "=== Set Union ==="
    set1 = ["a" => 1, "b" => 1, "c" => 1]
    set2 = ["b" => 1, "c" => 1, "d" => 1]
    
    print "Set1: ", set1
    print "Set2: ", set2

    print "Union: ", set_union(set1, set2)
    print "Intersection: ", set_intersection(set1, set2)
    print "Difference: ", set_diff(set1, set2)
}


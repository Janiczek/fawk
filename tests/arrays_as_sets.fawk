BEGIN {
    # Demonstrate using AWK associative arrays as sets
    # Sets store unique keys; the values don't matter
    
    print "=== Using Arrays as Sets ==="
    print ""
    
    # Test: accessing array elements auto-creates them (GAWK behavior)
    # This allows using arrays as sets by just accessing them
    print "Auto-creating array elements by access:"
    x[1]  # Just accessing x[1] creates the key
    print "  After x[1]:"
    print "    1 in x:", (1 in x)
    print "    2 in x:", (2 in x)
    print "    x[1]:", x[1]
    print "    x[2]:", x[2]
    print ""
    
    set = ["apple" => 1, "banana" => 1, "cherry" => 1]
    
    print "Initial set:"
    for (item in set) {
        print "  " item
    }
    print ""
    
    # Test for membership
    print "Membership tests:"
    if ("apple" in set) {
        print "  apple is in the set"
    }
    
    if ("grape" in set) {
        print "  grape is in the set"
    } else {
        print "  grape is NOT in the set"
    }
    print ""
    
    # Add a new element (traditional way)
    print "Adding 'grape' to set (traditional: set[\"grape\"] = 1)"
    set["grape"] = 1
    if ("grape" in set) {
        print "  grape is now in the set"
    }
    print ""
    
    # Add a new element using just access (new way - GAWK behavior)
    print "Adding 'mango' to set (just by accessing: set[\"mango\"])"
    set["mango"]  # Just accessing creates the key
    if ("mango" in set) {
        print "  mango is now in the set"
    }
    print ""
    
    # Remove an element (use delete in real AWK)
    # For demonstration, we'll show the pattern
    print "Removing 'banana' from set"
    delete set["banana"]
    if ("banana" in set) {
        print "  banana is still in the set"
    } else {
        print "  banana is NOT in the set (removed)"
    }
    print ""
    
    # Toggle an element (add if not present, remove if present)
    print "Toggle operations:"
    item = "cherry"
    if (item in set) {
        print "  Removing " item
        delete set[item]
    } else {
        print "  Adding " item
        set[item] = 1
    }
    
    item = "orange"
    if (item in set) {
        print "  Removing " item
        delete set[item]
    } else {
        print "  Adding " item
        set[item] = 1
    }
    print ""
    
    # Final set
    print "Final set:"
    for (item in set) {
        print "  " item
    }
    print ""
    
    print "=== Set Operations ==="
    set1 = ["a" => 1, "b" => 1, "c" => 1]
    set2 = ["b" => 1, "c" => 1, "d" => 1]
    
    print "Set1: ", keys(set1)
    print "Set2: ", keys(set2)

    print "Union: ", keys(set_union(set1, set2))
    print "Intersection: ", keys(set_intersection(set1, set2))
    print "Difference: ", keys(set_diff(set1, set2))
}


# Test: All Operators
# This test demonstrates all operators implemented in FAWK

function double(x) { return x * 2 }
function add10(x) { return x + 10 }

BEGIN {
    print "========================================"
    print "FAWK Operators Test Suite"
    print "========================================"
    print ""
    
    # Arithmetic Operators
    print "1. Arithmetic Operators"
    print "----------------------------------------"
    print "  10 + 5 =", 10 + 5
    print "  10 - 5 =", 10 - 5
    print "  10 * 5 =", 10 * 5
    print "  10 / 5 =", 10 / 5
    print "  10 % 3 =", 10 % 3
    print "  -10 =", -10
    print ""
    
    # Comparison Operators
    print "2. Comparison Operators"
    print "----------------------------------------"
    print "  10 == 10:", 10 == 10
    print "  10 == 5:", 10 == 5
    print "  10 != 5:", 10 != 5
    print "  10 != 10:", 10 != 10
    print "  10 < 20:", 10 < 20
    print "  20 < 10:", 20 < 10
    print "  10 <= 10:", 10 <= 10
    print "  10 <= 20:", 10 <= 20
    print "  20 > 10:", 20 > 10
    print "  10 > 20:", 10 > 20
    print "  10 >= 10:", 10 >= 10
    print "  20 >= 10:", 20 >= 10
    print ""
    
    # Logical Operators
    print "3. Logical Operators"
    print "----------------------------------------"
    print "  1 && 1:", 1 && 1
    print "  1 && 0:", 1 && 0
    print "  0 && 0:", 0 && 0
    print "  1 || 0:", 1 || 0
    print "  0 || 0:", 0 || 0
    print "  !1:", !1
    print "  !0:", !0
    print "  (5 > 3) && (2 < 4):", (5 > 3) && (2 < 4)
    print "  (5 > 3) || (2 > 4):", (5 > 3) || (2 > 4)
    print ""
    
    # Match Operators
    print "4. Match Operators (~, !~)"
    print "----------------------------------------"
    print "  'hello' ~ 'ell':", "hello" ~ "ell"
    print "  'hello' ~ 'xyz':", "hello" ~ "xyz"
    print "  'test123' ~ '[0-9]+':", "test123" ~ "[0-9]+"
    print "  'test123' ~ '^test':", "test123" ~ "^test"
    print "  'test123' ~ '123$':", "test123" ~ "123$"
    print "  'hello' !~ 'xyz':", "hello" !~ "xyz"
    print "  'hello' !~ 'ell':", "hello" !~ "ell"
    print "  'abc' !~ '[0-9]+':", "abc" !~ "[0-9]+"
    print ""
    
    # Assignment and Variables
    print "5. Assignment Operator"
    print "----------------------------------------"
    a = 10
    print "  a = 10; a =", a
    a = a + 5
    print "  a = a + 5; a =", a
    b = 20
    c = a + b
    print "  b = 20; c = a + b; c =", c
    print ""
    
    # String Concatenation
    print "6. String Operations"
    print "----------------------------------------"
    str1 = "hello"
    str2 = "world"
    print "  str1 = 'hello'"
    print "  str2 = 'world'"
    print "  Comparison: str1 == 'hello':", str1 == "hello"
    print "  Match: str1 ~ 'hel':", str1 ~ "hel"
    print ""
    
    # Pipeline Operator
    print "7. Pipeline Operator (|>)"
    print "----------------------------------------"
    print "  Using map with pipeline:"
    arr = [1, 2, 3, 4, 5]
    doubled = arr |> map((x) => { x * 2 })
    print "  [1,2,3,4,5] |> map((x) => { x * 2 }):"
    print "    Result: [", doubled[0], doubled[1], doubled[2], doubled[3], doubled[4], "]"
    print ""
    
    # Lambda (Arrow) Functions
    print "8. Lambda Functions (=>)"
    print "----------------------------------------"
    square = (x) => { x * x }
    print "  square = (x) => { x * x }"
    print "  square(7) =", square(7)
    add = (a, b) => { a + b }
    print "  add = (a, b) => { a + b }"
    print "  add(3, 4) =", add(3, 4)
    print ""
    
    # Complex Expressions
    print "9. Complex Expressions"
    print "----------------------------------------"
    x = 5
    y = 10
    z = 15
    print "  x = 5, y = 10, z = 15"
    print "  (x + y) * 2:", (x + y) * 2
    print "  x < y && y < z:", x < y && y < z
    print "  (x * 2 == y) && (y + 5 == z):", (x * 2 == y) && (y + 5 == z)
    print ""
    
    # Operator Precedence
    print "10. Operator Precedence"
    print "----------------------------------------"
    print "  2 + 3 * 4 =", 2 + 3 * 4
    print "  (2 + 3) * 4 =", (2 + 3) * 4
    print "  10 - 4 / 2 =", 10 - 4 / 2
    print "  (10 - 4) / 2 =", (10 - 4) / 2
    print "  5 > 3 && 4 < 6:", 5 > 3 && 4 < 6
    print "  5 > 3 || 4 > 6:", 5 > 3 || 4 > 6
    print ""
    
    print "========================================"
    print "All operator tests completed!"
    print "========================================"
}


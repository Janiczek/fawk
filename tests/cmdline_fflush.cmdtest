./fawk 'BEGIN { print "line1" > "/tmp/fawk_test_fflush.txt"; result1 = fflush("/tmp/fawk_test_fflush.txt"); print "fflush(file) returned:", result1; result2 = fflush(); print "fflush() returned:", result2; result3 = fflush("/dev/stdout"); print "fflush(/dev/stdout) returned:", result3; result4 = fflush("/tmp/fawk_test_fflush_nonexistent.txt"); print "fflush(nonexistent) returned:", result4; print "line2" >> "/tmp/fawk_test_fflush.txt"; result5 = fflush(""); print "fflush(\"\") returned:", result5 }' && test -f /tmp/fawk_test_fflush.txt && cat /tmp/fawk_test_fflush.txt && rm -f /tmp/fawk_test_fflush.txt


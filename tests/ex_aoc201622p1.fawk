NR >= 3 {
  [xx,yy] = $1 |> match(/-x([0-9]+)-y([0-9]+)$/)
  [x,y] = [xx,yy] |> map(int)

  if (y == max_y && x > max_x) { max_x = x }

  ++n
  coor[n]["x"] = x
  coor[n]["y"] = y
  used[x][y] = int($3)
  avai[x][y] = int($4)
}
END {
  # Part 1: count "viable nodes"
  # any two nodes (A,B) regardless of whether they are directly connected, such that
  # 1. A.Used != 0 
  # 2. A != B
  # 3. A.Used <= B.Avail

  for (i = 1; i <= n; i++) {
    x1 = coor[i]["x"]
    y1 = coor[i]["y"]
    used1 = used[x1][y1]
    if (used1 == 0) { continue } # 1
    for (j = 1; j <= n; j++) {
      if (i == j) { continue } # 2
      x2 = coor[j]["x"]
      y2 = coor[j]["y"]
      avai2 = avai[x2][y2]
      if (used1 <= avai2) { count++ } # 3
    }
  }
  print "Part 1 answer: ", count
}

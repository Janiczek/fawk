    print "   Array: ", num_assoc2
    result14 = max(num_assoc2)
    print "   Original unchanged: ", num_assoc2
    print "   max(num_assoc2): ", result14
    print ""
    
    # 15. Single element array
    print "15. Single element array:"
    single1 = [42]
    single2 = ["hello"]
    print "   Array [42]: ", single1
    print "   min([42]): ", min(single1)
    print "   max([42]): ", max(single1)
    print "   Array [\"hello\"]: ", single2
    print "   min([\"hello\"]): ", min(single2)
    print "   max([\"hello\"]): ", max(single2)
    print ""
    
    # 16. Case sensitivity - min
    print "16. Case sensitivity (min):"
    case_arr1 = ["abc", "aBc", "ABC", "Abc", "aBC", "abC"]
    print "   Array: ", case_arr1
    result16 = min(case_arr1)
    print "   Original unchanged: ", case_arr1
    print "   min(case_arr1): ", result16
    print ""
    
    # 17. Case sensitivity - max
    print "17. Case sensitivity (max):"
    case_arr2 = ["abc", "aBc", "ABC", "Abc", "aBC", "abC"]

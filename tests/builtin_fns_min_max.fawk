# Test: min() and max() functions

BEGIN {
    print "=== min() and max() Function Tests ==="
    print ""
    
    # 1. Simple numeric array - min
    print "1. Simple numeric array (min):"
    arr1 = [3, 1, 4, 1, 5, 9, 2, 6]
    print "   Array: ", arr1
    result1 = min(arr1)
    print "   Original unchanged: ", arr1
    print "   min(arr1): ", result1
    print ""
    
    # 2. Simple numeric array - max
    print "2. Simple numeric array (max):"
    arr2 = [3, 1, 4, 1, 5, 9, 2, 6]
    print "   Array: ", arr2
    result2 = max(arr2)
    print "   Original unchanged: ", arr2
    print "   max(arr2): ", result2
    print ""
    
    # 3. String array - min
    print "3. String array (min):"
    arr3 = ["zebra", "apple", "banana", "cherry"]
    print "   Array: ", arr3
    result3 = min(arr3)
    print "   Original unchanged: ", arr3
    print "   min(arr3): ", result3
    print ""
    
    # 4. String array - max
    print "4. String array (max):"
    arr4 = ["zebra", "apple", "banana", "cherry"]
    print "   Array: ", arr4
    result4 = max(arr4)
    print "   Original unchanged: ", arr4
    print "   max(arr4): ", result4
    print ""
    
    # 5. Mixed types (numbers come before strings)
    print "5. Mixed types - min (numbers before strings):"
    arr5 = ["hello", 42, "world", 10, "test", 5]
    print "   Array: ", arr5
    result5 = min(arr5)
    print "   Original unchanged: ", arr5
    print "   min(arr5): ", result5
    print ""
    
    # 6. Mixed types - max
    print "6. Mixed types - max (numbers before strings):"
    arr6 = ["hello", 42, "world", 10, "test", 5]
    print "   Array: ", arr6
    result6 = max(arr6)
    print "   Original unchanged: ", arr6
    print "   max(arr6): ", result6
    print ""
    
    # 7. Two arguments - min
    print "7. Two arguments (min):"
    result7a = min(5, 3)
    result7b = min(3, 5)
    result7c = min("apple", "zebra")
    result7d = min("zebra", "apple")
    result7e = min(10, "5")
    result7f = min("5", 10)
    print "   min(5, 3): ", result7a
    print "   min(3, 5): ", result7b
    print "   min(\"apple\", \"zebra\"): ", result7c
    print "   min(\"zebra\", \"apple\"): ", result7d
    print "   min(10, \"5\"): ", result7e
    print "   min(\"5\", 10): ", result7f
    print ""
    
    # 8. Two arguments - max
    print "8. Two arguments (max):"
    result8a = max(5, 3)
    result8b = max(3, 5)
    result8c = max("apple", "zebra")
    result8d = max("zebra", "apple")
    result8e = max(10, "5")
    result8f = max("5", 10)
    print "   max(5, 3): ", result8a
    print "   max(3, 5): ", result8b
    print "   max(\"apple\", \"zebra\"): ", result8c
    print "   max(\"zebra\", \"apple\"): ", result8d
    print "   max(10, \"5\"): ", result8e
    print "   max(\"5\", 10): ", result8f
    print ""
    
    # 9. Single scalar argument - min
    print "9. Single scalar argument (min):"
    result9a = min(42)
    result9b = min("hello")
    result9c = min(3.14)
    print "   min(42): ", result9a
    print "   min(\"hello\"): ", result9b
    print "   min(3.14): ", result9c
    print ""
    
    # 10. Single scalar argument - max
    print "10. Single scalar argument (max):"
    result10a = max(42)
    result10b = max("hello")
    result10c = max(3.14)
    print "   max(42): ", result10a
    print "   max(\"hello\"): ", result10b
    print "   max(3.14): ", result10c
    print ""
    
    # 11. Associative array with string keys - min
    print "11. Associative array (string keys) - min:"
    assoc1 = ["zebra" => 1, "apple" => 1, "banana" => 1]
    print "   Array: ", assoc1
    result11 = min(assoc1)
    print "   Original unchanged: ", assoc1
    print "   min(assoc1): ", result11
    print ""
    
    # 12. Associative array with string keys - max
    print "12. Associative array (string keys) - max:"
    assoc2 = ["zebra" => 1, "apple" => 1, "banana" => 1]
    print "   Array: ", assoc2
    result12 = max(assoc2)
    print "   Original unchanged: ", assoc2
    print "   max(assoc2): ", result12
    print ""
    
    # 13. Associative array with numeric keys - min
    print "13. Associative array (numeric keys) - min:"
    num_assoc1 = [10 => "ten", 2 => "two", 5 => "five", 1 => "one"]
    print "   Array: ", num_assoc1
    result13 = min(num_assoc1)
    print "   Original unchanged: ", num_assoc1
    print "   min(num_assoc1): ", result13
    print ""
    
    # 14. Associative array with numeric keys - max

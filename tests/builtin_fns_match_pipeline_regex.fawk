# Test: match() with regex literals in pipeline expressions
# This tests the fix for regex literals (e.g., /pattern/) when used
# as arguments to match() in pipeline expressions.

BEGIN {
    print "Test: match() with regex literals in pipelines"
    print "--------------------------------------"
    
    # Test 1: Regex literal in pipeline (the bug fix)
    text1 = "node-x42-y99"
    [x, y] = text1 |> match(/-x([0-9]+)-y([0-9]+)$/)
    print "  Text:", text1
    print "  Pattern: /-x([0-9]+)-y([0-9]+)$/"
    print "  Extracted x:", x
    print "  Extracted y:", y
    print ""
    
    # Test 2: Regex literal with flags
    text2 = "Hello WORLD"
    result = text2 |> match(/world/i)
    print "  Text:", text2
    print "  Pattern: /world/i (case-insensitive)"
    print "  Matched:", result[0]
    print ""
    
    # Test 3: Multiple groups with regex literal
    text3 = "date: 2024-12-25"
    [year, month, day] = text3 |> match(/([0-9]{4})-([0-9]{2})-([0-9]{2})/)
    print "  Text:", text3
    print "  Pattern: /([0-9]{4})-([0-9]{2})-([0-9]{2})/"
    print "  Year:", year
    print "  Month:", month
    print "  Day:", day
    print ""
    
    # Test 4: Compare regex literal vs string pattern (both should work)
    text4 = "price: $99.99"
    result_regex = text4 |> match(/\$([0-9]+)\.([0-9]+)/)
    result_string = text4 |> match("\\$([0-9]+)\\.([0-9]+)")
    print "  Text:", text4
    print "  Regex literal result:", result_regex[1], "dollars,", result_regex[2], "cents"
    print "  String pattern result:", result_string[1], "dollars,", result_string[2], "cents"
}


# Test: floor() function

BEGIN {
    print "floor(3.7) =", floor(3.7)
    print "floor(-3.7) =", floor(-3.7)
    print "floor(3.0) =", floor(3.0)
    print "floor(-3.0) =", floor(-3.0)
    print "floor(0.0) =", floor(0.0)
    print "floor(0.5) =", floor(0.5)
    print "floor(-0.5) =", floor(-0.5)
    print "floor(10.9) =", floor(10.9)
    print "floor(-10.9) =", floor(-10.9)
}


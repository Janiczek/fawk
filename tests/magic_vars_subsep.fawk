BEGIN {
    # Default SUBSEP
    arr = ["a" => 1, "b" => 2]
    
    # Test multi-dimensional array key construction
    # In AWK, arr[i,j] is stored as arr[i SUBSEP j]
    # FAWK doesn't support multi-dim syntax yet, but we can test SUBSEP directly
    
    print "Default SUBSEP (octal 034):", length(SUBSEP), "chars"
    
    # Change SUBSEP
    SUBSEP = ","
    print "Changed SUBSEP to comma:", SUBSEP
    
    SUBSEP = "::"
    print "Changed SUBSEP to double colon:", SUBSEP
}


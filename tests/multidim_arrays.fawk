BEGIN {
    # Test multi-dimensional array syntax arr[i,j]
    # In AWK, arr[i,j] is syntactic sugar for arr[i SUBSEP j]
    
    # Create a 2D array
    arr[1,2] = "a"
    arr[1,3] = "b"
    arr[2,1] = "c"
    arr[2,2] = "d"
    
    # Access elements
    print "arr[1,2] =", arr[1,2]
    print "arr[2,1] =", arr[2,1]
    
    # Test with strings
    matrix["row1","col1"] = 10
    matrix["row1","col2"] = 20
    matrix["row2","col1"] = 30
    matrix["row2","col2"] = 40
    
    print "matrix[row1,col1] =", matrix["row1","col1"]
    print "matrix[row2,col2] =", matrix["row2","col2"]
    
    # Test with 3 dimensions
    cube[1,2,3] = "xyz"
    cube[1,2,4] = "xyz2"
    print "cube[1,2,3] =", cube[1,2,3]
    print "cube[1,2,4] =", cube[1,2,4]
    
    # Test iteration with for-in
    print "Iterating over arr:"
    for (key in arr) {
        print "  key:", key, "value:", arr[key]
    }
}


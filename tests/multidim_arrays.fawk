BEGIN {
    # Test multi-dimensional array syntax arr[i,j]
    # In AWK, arr[i,j] is syntactic sugar for arr[i SUBSEP j]
    
    # Create a 2D array
    arr[1,2] = "a"
    arr[1,3] = "b"
    arr[2,1] = "c"
    arr[2,2] = "d"
    
    # Access elements
    print "arr[1,2] =", arr[1,2]
    print "arr[2,1] =", arr[2,1]
    
    # Test with strings
    matrix["row1","col1"] = 10
    matrix["row1","col2"] = 20
    matrix["row2","col1"] = 30
    matrix["row2","col2"] = 40
    
    print "matrix[row1,col1] =", matrix["row1","col1"]
    print "matrix[row2,col2] =", matrix["row2","col2"]
    
    # Test with 3 dimensions
    cube[1,2,3] = "xyz"
    cube[1,2,4] = "xyz2"
    print "cube[1,2,3] =", cube[1,2,3]
    print "cube[1,2,4] =", cube[1,2,4]
    
    # Test iteration with for-in
    print "Iterating over arr:"
    for (key in arr) {
        print "  key:", key, "value:", arr[key]
    }
    
    # Test array literals with multi-dimensional keys
    print "Testing array literals with multi-dimensional keys:"
    arr2 = [(1,2) => "a", (1,3) => "b", (2,1) => "c", (2,2) => "d"]
    print "arr2[1,2] =", arr2[1,2]
    print "arr2[2,1] =", arr2[2,1]
    
    # Test with string indices
    matrix2 = [("row1","col1") => 10, ("row1","col2") => 20, ("row2","col1") => 30, ("row2","col2") => 40]
    print "matrix2[row1,col1] =", matrix2["row1","col1"]
    print "matrix2[row2,col2] =", matrix2["row2","col2"]
    
    # Test with 3 dimensions
    cube2 = [(1,2,3) => "xyz", (1,2,4) => "xyz2"]
    print "cube2[1,2,3] =", cube2[1,2,3]
    print "cube2[1,2,4] =", cube2[1,2,4]
    
    # Test iteration over array literal
    print "Iterating over arr2:"
    for (key in arr2) {
        print "  key:", key, "value:", arr2[key]
    }
}


# Test: Comparison Operators

BEGIN {
    print "Test: Comparison Operators"
    print "--------------------------------------"
    print "  10 == 10:", 10 == 10
    print "  10 == 5:", 10 == 5
    print "  10 != 5:", 10 != 5
    print "  10 != 10:", 10 != 10
    print "  10 < 20:", 10 < 20
    print "  20 < 10:", 20 < 10
    print "  10 <= 10:", 10 <= 10
    print "  10 <= 20:", 10 <= 20
    print "  20 > 10:", (20 > 10)
    print "  10 > 20:", (10 > 20)
    print "  10 >= 10:", (10 >= 10)
    print "  20 >= 10:", (20 >= 10)
    print ""
    
    print "String Comparisons:"
    print "--------------------------------------"
    str1 = "hello"
    print "  str1 = 'hello'"
    print "  str1 == 'hello':", str1 == "hello"
    print "  str1 == 'world':", str1 == "world"
}


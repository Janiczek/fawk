#!/usr/bin/env bash
# FAWK Wrapper Script
# Runs the Python FAWK interpreter

# Get the directory where this script is located
LINK_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${LINK_SOURCE}")" && pwd)"

# Run the Python interpreter using uv
source "${SCRIPT_DIR}/.venv/bin/activate"
PYTHONPATH="${SCRIPT_DIR}/src:${PYTHONPATH}" python3 -m fawk.fawk "$@"
